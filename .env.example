# Local development only.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-at-least-32-characters"
AUTH_TRUST_HOST="true"
AUTH_URL="http://127.0.0.1:3000"
NEXTAUTH_URL="http://127.0.0.1:3000"
UPLOADS_DIR="/absolute/local/path/to/uploads"

# 외부 연동 (mleverage-admin 등)이 /api/external/leads 호출 시 x-api-key 헤더로 보내는 공유키.
# 비워두면 해당 엔드포인트는 항상 401을 반환한다 (fail closed).
LEADS_INTAKE_API_KEY="replace-with-a-strong-random-key"

# WARP의 문의 등록 전용 인증키. 미설정이면 전송하지 않습니다.
# 운영에서는 승인된 비밀값 주입 경로로 제공하고 기존 BUILDUP 키를 재사용하지 않습니다.
WARP_MARKETING_API_KEY=""
# 파일럿 전송과 CRM 확인 후에만 true로 설정합니다. 키만으로는 자동 전송하지 않습니다.
WARP_DELIVERY_ENABLED="false"

# Server collector: inject both at runtime; no values are stored in the image.
MLEVERAGE_USERNAME=""
MLEVERAGE_PASSWORD=""
# Optional: Linux defaults to true; macOS defaults to false. Accepts true or false only.
INQUIRY_BROWSER_HEADLESS=""
# Optional path to an existing Chrome/Chromium executable.
INQUIRY_BROWSER_EXECUTABLE=""
