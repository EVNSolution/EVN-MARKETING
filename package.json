{
  "name": "evn-marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-landing-public.mjs && next dev --webpack",
    "build": "node scripts/build-landing-public.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "test:db": "tsx tests/db.test.ts",
    "test:ad-billing": "tsx tests/ad-billing.test.ts",
    "test:external-dashboard": "tsx tests/external-dashboard.test.ts && tsx tests/registered-inflow.test.ts && tsx tests/ad-spend.test.ts && tsx tests/naver-ad-spend.test.ts && tsx tests/daangn-ad-spend.test.ts && tsx tests/daangn-mcp-ad-spend.test.ts && tsx tests/ad-spend-worker.test.ts",
    "check:external-dashboard": "tsx scripts/check-external-dashboard.ts",
    "test:landing": "tsx tests/landing-inquiries.test.ts && node tests/landing-expansion-audit.test.mjs",
    "test:schema": "node tests/schema-check.test.mjs && node tests/landing-schema-bridge.test.mjs",
    "test:data-recovery": "tsx tests/data-recovery.test.ts",
    "test:backup": "node tests/data-backup.test.mjs && python3 tests/data-ops.test.py",
    "test:warp-recovery": "tsx tests/warp-recovery.test.ts",
    "test:inquiries": "tsx tests/inquiry-sync.test.ts && tsx tests/mleverage-source.test.ts && tsx tests/inquiry-management-actions.test.ts && tsx tests/inquiry-review.test.ts",
    "test:server-runtime": "tsx tests/server-runtime.test.ts && tsx tests/readiness.test.ts",
    "test:upload-security": "tsx tests/upload-security.test.ts",
    "test:upload-processes": "tsx tests/upload-processes.test.ts",
    "test:release-routing": "node tests/release-routing.test.mjs",
    "test:worker-runtime": "tsx tests/worker-runtime.test.ts && tsx tests/worker-activation.test.ts",
    "test:deploy-controller": "python3 tests/deploy-controller.test.py",
    "test:worker-health": "tsx tests/worker-health.test.ts",
    "test:worker-processes": "tsx tests/worker-processes.test.ts",
    "test:warp-delivery": "tsx tests/warp-delivery.test.ts && tsx tests/warp-delivery-cli.test.ts && tsx tests/landing-warp.test.ts && tsx tests/customer-lead-registration.test.ts",
    "test:integration-contract": "node scripts/verify-direct-integration-contract.mjs evn-marketing",
    "worker:inquiries": "tsx workers/inquiry-sync.ts",
    "preview:inquiries": "tsx tests/setup-inquiry-preview.ts",
    "warp:delivery": "tsx scripts/warp-delivery.ts",
    "deploy": "python3 deploy/aws/operator-release.py release",
    "deploy:rollback": "python3 deploy/aws/operator-release.py rollback"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.17.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "playwright-core": "^1.63.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.6",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "better-sqlite3@12.11.1": true
  }
}
